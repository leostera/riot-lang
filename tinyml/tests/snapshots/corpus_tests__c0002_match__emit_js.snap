function get_or_zero(x: unknown): unknown {
  return (($tinyml_match) => {
  switch ($tinyml_match.type) {
    case "None":
      return BigInt("0");
    case "Some":
      return $tinyml_match.value;
  }
})(x);
}

export { get_or_zero };

