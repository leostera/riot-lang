function double(x: unknown): bigint {
  return $tinyml_integer("mul", x, BigInt("2"), 32, true);
}

function main(x: unknown): unknown {
  const y = $tinyml_integer("add", x, BigInt("1"), 32, true);
  return double(y);
}

